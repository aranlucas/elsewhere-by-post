{
  "name": "elsewhere-by-post",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny impossible postcard map. Turn places, swap the world, deliver a little wonder.",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "dev:portless": "portless run --name elsewhere-by-post node scripts/server.mjs",
    "start": "node scripts/server.mjs --dist",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm run lint && npm test && npm run build",
    "lint": "oxlint ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "oxlint": "1.86.0",
    "@oxlint/plugins": "1.86.0"
  }
}
